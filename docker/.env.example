# ---------------------------------------------------------------------------
# Dev environment for the trading ecosystem. Copy to docker/.env and adjust.
# These are DEV-ONLY credentials — never use them in production.
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=trading_dev_pass

# --- Redis (cache) ---
# no auth in dev

# --- RabbitMQ ---
# NOTE: the actual broker users/passwords are defined (hashed) in
# docker/rabbitmq/definitions.json. These vars are only what the apps connect
# with — changing RABBITMQ_APP_PASS here has NO effect unless you also regenerate
# the matching password_hash in definitions.json:
#   docker exec rmp-rabbitmq rabbitmqctl hash_password 'new_pass'
# then paste the output into the "app" user's password_hash field.
#   admin / rmp_dev_pass   (management UI, full access)
#   app   / app_dev_pass   (application user)
RABBITMQ_APP_USER=app
RABBITMQ_APP_PASS=app_dev_pass

# --- ClickHouse ---
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics_dev_pass

# --- JWT (shared secret between gateway and db-service, HS256, >= 32 chars) ---
JWT_SECRET=rmp_investment_dev_secret_change_me_32+chars
JWT_ISSUER=rmp-trading
JWT_AUDIENCE=rmp-clients
JWT_ACCESS_TTL_SECONDS=86400

# --- Grafana ---
GRAFANA_PASS=admin

# --- Gateway / CORS (RN web build only; native apps don't use CORS) ---
CORS_ALLOWED_HOSTS=http://localhost:19006,http://localhost:8081

# --- Load imitator (iteration 2) ---
IMITATOR_CLIENTS=10000
IMITATOR_RAMP_UP=120
IMITATOR_DURATION=600
